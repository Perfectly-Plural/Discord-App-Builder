{
  "name": "discord-app-builder-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-platform desktop edition of Discord App Builder",
  "author": "Perfectly Plural",
  "homepage": "https://github.com/Perfectly-Plural/Discord-App-Builder",
  "desktopName": "discord-app-builder",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "generate:templates": "node scripts/generate-templates.cjs",
    "build:renderer": "vite build",
    "package:windows:x64": "electron-builder --win nsis --x64",
    "package:windows:arm64": "electron-builder --win nsis --arm64",
    "build:windows": "npm run build:renderer && npm run generate:templates && npm run package:windows:x64 && npm run package:windows:arm64",
    "package:linux:x64": "electron-builder --linux AppImage deb --x64",
    "package:linux:arm64": "electron-builder --linux AppImage deb --arm64",
    "build:linux": "npm run build:renderer && npm run generate:templates && npm run package:linux:x64 && npm run package:linux:arm64",
    "build": "npm run build:windows",
    "build:dir": "npm run build:renderer && npm run generate:templates && electron-builder --dir",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.5",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.1.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "software.perfectlyplural.discord-app-builder",
    "productName": "Discord App Builder",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist-renderer/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "generated/templates.json",
        "to": "templates/templates.json"
      },
      {
        "from": "../Assets/AppIcon.png",
        "to": "assets/AppIcon.png"
      }
    ],
    "win": {
      "icon": "../Assets/AppIcon.png",
      "target": [
        { "target": "nsis", "arch": ["x64", "arm64"] }
      ],
      "artifactName": "Discord-App-Builder-Windows-Setup-${arch}-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Discord App Builder"
    },
    "linux": {
      "icon": "../Assets/AppIcon.png",
      "target": [
        { "target": "AppImage", "arch": ["x64", "arm64"] },
        { "target": "deb", "arch": ["x64", "arm64"] }
      ],
      "category": "Development",
      "synopsis": "Visual workflow editor for Discord bots",
      "description": "Build Discord bots with a visual block workflow editor.",
      "maintainer": "Perfectly Plural",
      "syncDesktopName": true,
      "artifactName": "Discord-App-Builder-Linux-${arch}-${version}.${ext}"
    }
  }
}
